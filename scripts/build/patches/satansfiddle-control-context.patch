+// MWCC's private integer literal is four big-significance-order 32-bit limbs.
+// Accept only sign-extended small source integers; never interpret arena residue.
+fn small_integer(process: &SBProcess, payload: u64) -> Result<Option<i32>> {
+    let value = u32_at(process, payload + 12)? as i32;
+    let extension = if value < 0 { u32::MAX } else { 0 };
+    for offset in [0, 4, 8] {
+        if u32_at(process, payload + offset)? != extension { return Ok(None); }
+    }
+    Ok(Some(value))
+}
+
+fn condition_integer(process: &SBProcess, c: &Compiler, expression: u32) -> Result<Option<(i32, u8)>> {
+    if expression == 0 { return Ok(None); }
+    let kind = read(process, expression as u64, 1)?[0];
+    if !matches!(kind, 0x17 | 0x18) { return Ok(None); }
+    for offset in [c.node_value, c.node_value + 4] {
+        let child = u32_at(process, expression as u64 + offset)? as u64;
+        if child != 0 && read(process, child, 1)?[0] == 0x32 {
+            if let Some(value) = small_integer(process, child + c.node_value)? {
+                return Ok(Some((value, kind)));
+            }
+        }
+    }
+    Ok(None)
+}
+
+fn statement_contexts(process: &SBProcess, c: &Compiler, mut statement: u32)
+    -> Result<HashMap<u32, Vec<config::ControlSelector>>> {
+    let mut statements = Vec::new();
+    let mut visited = HashSet::new();
+    while statement != 0 {
+        ensure!(visited.insert(statement), "cyclic lowered statement list");
+        ensure!(visited.len() <= 8192, "statement list exceeds verified limit");
+        let address = statement as u64;
+        let kind = read(process, address + 4, 1)?[0];
+        let mut record = Statement { address: statement, ..Statement::default() };
+        if kind == 2 {
+            record.label = Some(u32_at(process, address + 14)?);
+        } else if matches!(kind, 6 | 7) {
+            if let Some((value, comparison)) = condition_integer(process, c, u32_at(process, address + 10)?)? {
+                record.conditional = Some(Conditional {
+                    value,
+                    jump_when_equal: (kind == 6) == (comparison == 0x17),
+                    target: u32_at(process, address + 14)?,
+                });
+            }
+        } else if kind == 5 {
+            let descriptor = u32_at(process, address + 14)? as u64;
+            ensure!(descriptor != 0, "null switch descriptor");
+            record.switch_end = Some(u32_at(process, descriptor + 4)?);
+            let mut case = u32_at(process, descriptor)? as u64;
+            let mut cases_seen = HashSet::new();
+            while case != 0 {
+                ensure!(cases_seen.insert(case), "cyclic switch case list");
+                ensure!(cases_seen.len() <= 1024, "switch case list exceeds verified limit");
+                let lower = small_integer(process, case + 8)?;
+                let upper = small_integer(process, case + 24)?;
+                if let (Some(lower), Some(upper)) = (lower, upper) {
+                    // Ranges larger than the source-selector limit stay unsupported.
+                    if upper >= lower && i64::from(upper) - i64::from(lower) < 16 {
+                        for value in lower..=upper {
+                            record.cases.push((value, u32_at(process, case + 4)?));
+                        }
+                    }
+                }
+                case = u32_at(process, case)? as u64;
+            }
+        }
+        statements.push(record);
+        statement = u32_at(process, address)?;
+    }
+    Ok(control::contexts(&statements))
+}
+
+fn call_arguments(process: &SBProcess, mut list: u32) -> Result<Vec<u32>> {
+    let mut arguments = Vec::new();
+    while list != 0 {
+        ensure!(!arguments.contains(&list), "cyclic call argument list");
+        ensure!(arguments.len() < 16, "call argument list exceeds verified limit");
+        arguments.push(list);
+        list = u32_at(process, list as u64)?;
+    }
+    Ok(arguments)
+}
+
+fn link_arguments(process: &SBProcess, frame: &SBFrame, arguments: &[u32]) -> Result<()> {
+    for (index, &argument) in arguments.iter().enumerate() {
+        let next = arguments.get(index + 1).copied().unwrap_or(0);
+        write(process, argument as u64, &next.to_le_bytes())?;
+    }
+    register(frame, "esi")?.set_value(&arguments.first().copied().unwrap_or(0).to_string())
+        .map_err(|e| anyhow!("write argument walk head: {e:?}"))?;
+    Ok(())
+}

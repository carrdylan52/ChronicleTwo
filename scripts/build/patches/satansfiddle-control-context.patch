+fn real_control_regions_and_ordinary_argument_walk() {
+    let compiler = PathBuf::from(env::var_os("SATANSFIDDLE_TEST_COMPILER_300").unwrap());
+    let work = Workspace::new();
+    let input = work.0.join("semantic.cpp");
+    let config = work.0.join("config.json");
+    let source = r#"
+extern void consume(float, float, float, float);
+extern float width, height;
+void shots(int mode) {
+    if (mode == 40) consume(0.0f, 512.0f, width, 160.0f);
+    if (mode == 90) consume(0.0f, 512.0f, width, 160.0f);
+}
+void placements(int mode) {
+    switch (mode) {
+        case 9: case 10:
+            consume(0.0f, 512.0f, width, 0.5f);
+            consume(0.0f, 480.0f, height, 0.95f);
+            break;
+        default: break;
+    }
+    if (mode == 7 || mode == 9 || mode == 10) {
+        consume(0.0f, 512.0f, width, 0.5f);
+        consume(0.0f, 480.0f, height, 0.95f);
+    }
+    if (mode == 11) {
+        consume(0.0f, 512.0f, width, 0.5f);
+        consume(0.0f, 480.0f, height, 0.5f);
+    }
+}
+void untouched() { consume(0.0f, 512.0f, width, 160.0f); }
+"#;
+    fs::write(&input, source).unwrap();
+    let baseline = work.0.join("baseline.o");
+    fs::write(&config, compiler_config(&compiler, "")).unwrap();
+    assert_success(&cli(&input, &baseline, &config));
+    let base = fs::read(&baseline).unwrap();
+    let policy = r#"
+[[floating_point.expression_overrides]]
+translation_unit='semantic.cpp'
+function='shots__Fi'
+callee='consume__Fffff'
+value_type='binary32'
+value_bits='0x43200000'
+evaluate_first=true
+[floating_point.expression_overrides.control]
+kind='condition'
+values=[90]
+[[floating_point.expression_overrides]]
+translation_unit='semantic.cpp'
+function='placements__Fi'
+callee='consume__Fffff'
+value_type='binary32'
+value_bits='0x3f000000'
+evaluate_first=true
+[floating_point.expression_overrides.control]
+kind='switch'
+values=[9,10]
+[[floating_point.expression_overrides]]
+translation_unit='semantic.cpp'
+function='placements__Fi'
+callee='consume__Fffff'
+value_type='binary32'
+value_bits='0x3f733333'
+evaluate_first=true
+[floating_point.expression_overrides.control]
+kind='condition'
+values=[7,9,10]
+[[floating_point.expression_overrides]]
+translation_unit='semantic.cpp'
+function='placements__Fi'
+callee='consume__Fffff'
+value_type='binary32'
+value_bits='0x3f000000'
+evaluate_first=false
+evaluate_before=1
+[floating_point.expression_overrides.control]
+kind='condition'
+values=[11]
+[floating_point.expression_overrides.argument]
+argument_index=1
+value_type='binary32'
+value_bits='0x44000000'
+[[floating_point.expression_overrides]]
+translation_unit='semantic.cpp'
+function='placements__Fi'
+callee='consume__Fffff'
+value_type='binary32'
+value_bits='0x3f000000'
+evaluate_first=true
+[floating_point.expression_overrides.control]
+kind='condition'
+values=[11]
+[floating_point.expression_overrides.argument]
+argument_index=1
+value_type='binary32'
+value_bits='0x43f00000'
+"#;
+    let mut repeated = Vec::new();
+    for serial in 0..2 {
+        fs::write(&config, compiler_config(&compiler, policy)).unwrap();
+        let output = work.0.join(format!("selected-{serial}.o"));
+        assert_success(&cli(&input, &output, &config));
+        let actual = fs::read(&output).unwrap();
+        for function in ["shots__Fi", "placements__Fi"] {
+            assert_ne!(function_bytes(&base, function), function_bytes(&actual, function));
+        }
+        assert_eq!(function_bytes(&base, "untouched__Fv"), function_bytes(&actual, "untouched__Fv"));
+        let code = function_bytes(&actual, "placements__Fi");
+        if serial == 0 { repeated = code; } else { assert_eq!(repeated, code); }
+    }
+    // A generated filename still resolves the original semantic unit identity.
+    let generated = work.0.join("temporary.cpp");
+    fs::write(&generated, source).unwrap();
+    let output = work.0.join("generated.o");
+    assert_success(&cli_command(&generated, &output, &config).arg("--translation-unit")
+        .arg("path/semantic.cpp").output().unwrap());
+    assert_eq!(repeated, function_bytes(&fs::read(&output).unwrap(), "placements__Fi"));
+    fs::write(&config, compiler_config(&compiler, &policy.replace("values=[90]", "values=[91]"))).unwrap();
+    let failed = work.0.join("stale.o");
+    assert!(!cli(&input, &failed, &config).status.success());
+    assert!(!failed.exists());
+}
